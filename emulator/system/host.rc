#include <windows.h>
#include "host_resource.h"

// Application icon (title bar / taskbar / Alt-Tab / the .exe in Explorer).
// Lowest icon id, so Windows picks it as the executable's default icon.
IDI_APPICON ICON "vectrex-emu.ico"

// The controller graphic, embedded straight into the .exe as raw bytes. Decoded
// at runtime with stb_image (stbi_load_from_memory) -- no external file needed.
IDB_CONTROLLER_PNG RCDATA "vectrex_controller.png"

IDR_HOST_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load ROM...\tCtrl+O",   IDM_LOADROM
        MENUITEM "Load &Overlay...\tCtrl+L", IDM_LOADOVERLAY
        MENUITEM "Clear O&verlay",         IDM_CLEAROVERLAY
        MENUITEM "&Reset\tCtrl+R",         IDM_RESET
        MENUITEM "S&napshot\tF12",         IDM_SNAPSHOT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                  IDM_EXIT
    END
    POPUP "&Video"
    BEGIN
        MENUITEM "&Fullscreen\tF11",       IDM_FULLSCREEN
        MENUITEM SEPARATOR
        MENUITEM "&1x",                    IDM_SCALE_1X
        MENUITEM "&2x",                    IDM_SCALE_2X
        MENUITEM "&3x",                    IDM_SCALE_3X
        MENUITEM "&Fit",                   IDM_SCALE_FIT
        MENUITEM SEPARATOR
        MENUITEM "&Glow",                  IDM_VID_GLOW
        MENUITEM "&Trail",                 IDM_VID_TRAIL
        MENUITEM "&Overlay",               IDM_VID_OVERLAY
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Vector Graphics...",       IDM_SETTINGS_VIDEO
        MENUITEM "&Input (Controllers)...\tCtrl+I", IDM_SETTINGS_INPUT
        MENUITEM "&Audio...",                 IDM_SETTINGS_AUDIO
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",              IDM_ABOUT
    END
END

IDR_HOST_ACCEL ACCELERATORS
BEGIN
    VK_F11,    IDM_FULLSCREEN, VIRTKEY
    VK_F12,    IDM_SNAPSHOT,   VIRTKEY
    VK_RETURN, IDM_FULLSCREEN, VIRTKEY, ALT
    "O",       IDM_LOADROM,    VIRTKEY, CONTROL
    "L",       IDM_LOADOVERLAY,VIRTKEY, CONTROL
    "R",       IDM_RESET,      VIRTKEY, CONTROL
    "I",       IDM_SETTINGS_INPUT, VIRTKEY, CONTROL
END

// ===== Settings dialogs: one focused window per section ======================

// ----- Video -----
IDD_PAGE_VIDEO DIALOGEX 0, 0, 248, 172
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vector Graphics"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Glow amount:", IDC_STATIC, 10, 14, 58, 8
    CONTROL         "", IDC_GLOW_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 72, 10, 120, 18
    LTEXT           "0", IDC_GLOW_VALUE, 198, 14, 40, 8
    LTEXT           "Line width:", IDC_STATIC, 10, 40, 58, 8
    CONTROL         "", IDC_LINEWIDTH_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 72, 36, 120, 18
    LTEXT           "1.0", IDC_LINEWIDTH_VALUE, 198, 40, 40, 8
    LTEXT           "Endpoint size:", IDC_STATIC, 10, 66, 58, 8
    CONTROL         "", IDC_POINT_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 72, 62, 120, 18
    LTEXT           "1.0", IDC_POINT_VALUE, 198, 66, 40, 8
    LTEXT           "Dot size:", IDC_STATIC, 10, 92, 58, 8
    CONTROL         "", IDC_DOT_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 72, 88, 120, 18
    LTEXT           "2.0", IDC_DOT_VALUE, 198, 92, 40, 8
    LTEXT           "Changes auto-save for the current game. The buttons below manage the global defaults (games with no saved settings).",
                    IDC_STATIC, 10, 114, 230, 18
    PUSHBUTTON      "Save as Default", IDC_SAVE_DEFAULT, 10, 150, 76, 14
    PUSHBUTTON      "Reset to Default", IDC_RESET_DEFAULT, 90, 150, 76, 14
    DEFPUSHBUTTON   "Close", IDOK, 190, 150, 48, 14
END

// ----- Audio -----
IDD_PAGE_AUDIO DIALOGEX 0, 0, 252, 138
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audio Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Master volume:", IDC_STATIC, 10, 14, 62, 8
    CONTROL         "", IDC_VOLUME_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 76, 10, 120, 18
    LTEXT           "80%", IDC_VOLUME_VALUE, 202, 14, 40, 8
    AUTOCHECKBOX    "Ambient sound (flyback buzz)", IDC_AMBIENT_CHECK, 10, 44, 180, 10
    LTEXT           "Ambient volume:", IDC_STATIC, 10, 66, 62, 8
    CONTROL         "", IDC_AMBIENT_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 76, 62, 120, 18
    LTEXT           "20%", IDC_AMBIENT_VALUE, 202, 66, 40, 8
    LTEXT           "Audio settings are emulator-wide (not per game) and saved to emulator.ini.",
                    IDC_STATIC, 10, 90, 232, 16
    DEFPUSHBUTTON   "Close", IDOK, 194, 116, 48, 14
END

// ----- Input (controllers) -----
IDD_PAGE_INPUT DIALOGEX 0, 0, 300, 320
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input - Controllers"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "", IDC_CTRL_IMAGE, "Static", SS_OWNERDRAW | WS_VISIBLE, 30, 7, 240, 109
    CONTROL         "", IDC_CTRL_TAB, "SysTabControl32", WS_TABSTOP, 8, 120, 284, 170
    LTEXT           "Keyboard", IDC_STATIC, 90, 139, 84, 8
    LTEXT           "Joystick / Gamepad", IDC_STATIC, 180, 139, 104, 8
    LTEXT           "Up",       IDC_STATIC, 18, 154, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+0,  86, 152, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+8, 176, 152, 108, 13
    LTEXT           "Down",     IDC_STATIC, 18, 170, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+1,  86, 168, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+9, 176, 168, 108, 13
    LTEXT           "Left",     IDC_STATIC, 18, 186, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+2,  86, 184, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+10,176, 184, 108, 13
    LTEXT           "Right",    IDC_STATIC, 18, 202, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+3,  86, 200, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+11,176, 200, 108, 13
    LTEXT           "Button 1", IDC_STATIC, 18, 218, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+4,  86, 216, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+12,176, 216, 108, 13
    LTEXT           "Button 2", IDC_STATIC, 18, 234, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+5,  86, 232, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+13,176, 232, 108, 13
    LTEXT           "Button 3", IDC_STATIC, 18, 250, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+6,  86, 248, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+14,176, 248, 108, 13
    LTEXT           "Button 4", IDC_STATIC, 18, 266, 60, 8
    PUSHBUTTON      "", IDC_BIND_FIRST+7,  86, 264, 86, 13
    PUSHBUTTON      "", IDC_BIND_FIRST+15,176, 264, 108, 13
    PUSHBUTTON      "Restore Defaults", IDC_CTRL_DEFAULTS, 8, 299, 90, 14
    DEFPUSHBUTTON   "Close", IDOK, 242, 299, 50, 14
END
